{
  "name": "fancreed",
  "main": "index.ts",
  "version": "1.0.0",
  "scripts": {
    "eas-build-on-success": "npx bugsnag-eas-build-on-success",
    "start": "expo start",
    "lint": "expo lint && yarn check:structure",
    "check:structure": "node scripts/check-structure.js",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "format": "prettier --write \"{src,__tests__}/**/*.{ts,tsx}\"",
    "icons": "node scripts/generate-icons.js",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "ios:release": "expo run:ios --configuration Release",
    "android:release": "cd android && ./gradlew assembleRelease",
    "android:release:aab": "cd android && ./gradlew bundleRelease",
    "eas:dev:ios": "eas build --profile development --platform ios",
    "eas:dev:android": "eas build --profile development --platform android",
    "eas:dev:simulator": "eas build --profile development-simulator --platform ios",
    "eas:preview:ios": "eas build --profile preview --platform ios",
    "eas:preview:android": "eas build --profile preview --platform android",
    "eas:prod:ios": "eas build --profile production --platform ios",
    "eas:prod:android": "eas build --profile production --platform android",
    "eas:prod:ios:submit": "eas build --profile production --platform ios --auto-submit",
    "eas:prod:android:submit": "eas build --profile production --platform android --auto-submit",
    "android:setup": "node scripts/setup-android-sdk.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "e2e": "maestro test .maestro",
    "prepare": "husky"
  },
  "dependencies": {
    "@bugsnag/expo": "^57.1.0",
    "@bugsnag/expo-performance": "^57.0.1",
    "@hookform/resolvers": "^5.9.1",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/react-query": "^5.101.0",
    "app-icon-badge": "^0.1.2",
    "axios": "^1.13.5",
    "expo": "^57.0.25",
    "expo-application": "~57.0.3",
    "expo-blur": "~57.0.3",
    "expo-calendar": "~57.0.5",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.20",
    "expo-network": "~57.0.2",
    "expo-router": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "i18next": "^25.10.10",
    "react": "19.2.3",
    "react-hook-form": "^7.71.1",
    "react-i18next": "^16.5.4",
    "react-native": "0.86.3",
    "react-native-edge-to-edge": "^1.7.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-unistyles": "^3.3.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@bugsnag/plugin-expo-eas-sourcemaps": "^57.0.0",
    "@bugsnag/source-maps": "^2.3.3",
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@dev-plugins/react-query": "^0.4.0",
    "@react-native/jest-preset": "~0.86.3",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@svgr/plugin-svgo": "^8.1.0",
    "@tanstack/eslint-plugin-query": "^5.91.4",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.4",
    "@types/react-test-renderer": "^19",
    "babel-jest": "^30.2.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-expo": "~57.0.5",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "react-test-renderer": "19.2.3",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "resolutions": {
    "jest-mock": "^30.4.1"
  },
  "private": true,
  "packageManager": "yarn@1.22.22",
  "expo": {
    "install": {
      "exclude": [
        "jest",
        "@types/jest"
      ]
    }
  }
}
