# App environment (dev | stg | prod)
EXPO_PUBLIC_RUN_MODE=dev

# API base URL
# Optional: override the API URL set per build in env.ts
# EXPO_PUBLIC_API_URL=https://app.fancreed.com/api/

# BugSnag API key (optional, leave empty to disable error reporting)
EXPO_PUBLIC_BUGSNAG_API_KEY=

# Dev builds only: test account prefilled in the sign-in form.
# Put real values in .env.local (git-ignored) — never here.
# EXPO_PUBLIC_DEV_LOGIN=
# EXPO_PUBLIC_DEV_PASSWORD=

# true = invalid env fails (EAS builds set this); false/unset = warn only
STRICT_ENV_VALIDATION=true

# ℹ️  Auth tokens are stored in iOS Keychain / Android Keystore
# via expo-secure-store — never bundled into the JS layer.
